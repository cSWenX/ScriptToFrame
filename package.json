{
  "name": "script-to-frame",
  "version": "1.0.0",
  "description": "漫剧剧本自动分镜图生成器 - ScriptToFrame",
  "main": "index.js",
  "engines": {
    "node": ">=16.14.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "start:all": "./start.sh",
    "stop:all": "./stop.sh",
    "logs": "./logs.sh",
    "logs:backend": "tail -f logs/backend.log",
    "logs:frontend": "tail -f logs/frontend.log",
    "logs:all": "tail -f logs/combined.log",
    "backend": "cd python-backend && source venv/bin/activate && uvicorn main:app --host 0.0.0.0 --port 8081 --reload",
    "frontend": "next dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@volcengine/openapi": "^1.33.0",
    "@volcengine/tos-sdk": "^2.9.0",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.14",
    "axios": "^1.4.0",
    "dotenv": "^16.0.3",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "next": "^13.5.0",
    "postcss": "^8.4.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pageflip": "^2.0.3",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^13.5.0",
    "typescript": "^5.0.0"
