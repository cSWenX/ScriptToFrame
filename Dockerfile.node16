# Node.js 16 兼容的Dockerfile
FROM node:16-alpine

WORKDIR /app

# 安装Python和必要工具
RUN apk add --no-cache \
    python3 \
    py3-pip \
    curl \
    bash \
    && ln -sf python3 /usr/bin/python

# 复制Node.js 16兼容的配置文件
COPY package.node16.json ./package.json
COPY next.config.node16.js ./next.config.js

# 安装前端依赖
RUN npm install

# 复制源代码
COPY . .

# 安装Python后端依赖
WORKDIR /app/python-backend
RUN pip3 install -r requirements.txt

# 回到工作目录
WORKDIR /app

# 构建Next.js应用
RUN npm run build

# 确保启动脚本可执行
RUN chmod +x docker-entrypoint.sh

# 创建非root用户
RUN addgroup --gid 1001 nodejs \
    && adduser --uid 1001 --gid nodejs --shell /bin/bash --disabled-password nextjs

# 创建必要目录并设置权限
RUN mkdir -p /app/logs && chown -R nextjs:nodejs /app

# 切换到非root用户
USER nextjs

# 暴露端口
EXPOSE 3000 8081

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

# 启动命令
CMD ["./docker-entrypoint.sh"]